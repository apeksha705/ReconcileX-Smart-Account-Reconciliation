# ─────────────────────────────────────────────────────────────────────────────
# RECONCILEX FRONTEND — Environment Variables
# Copy this file to .env.local for local development.
# For Vercel deployment, set VITE_API_URL in the Vercel project settings.
# ─────────────────────────────────────────────────────────────────────────────

# Local development (backend running on localhost)
VITE_API_URL=http://localhost:5000/api

# Production example (replace with your actual Render backend URL)
# VITE_API_URL=https://reconcilex-api.onrender.com/api
